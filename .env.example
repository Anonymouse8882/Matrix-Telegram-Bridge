# Copy to .env and fill in. docker compose reads this automatically.
# These OVERRIDE the values in config.yaml, so keep your real secrets only here.

# --- Matrix ---
# Use EITHER an access token (recommended) OR a password.
MATRIX_ACCESS_TOKEN=
# MATRIX_PASSWORD=

# --- Telegram (user account / MTProto) ---
# From https://my.telegram.org  ->  API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional; the phone number of the Telegram account (with country code).
TELEGRAM_PHONE=

# Optional
LOG_LEVEL=INFO
